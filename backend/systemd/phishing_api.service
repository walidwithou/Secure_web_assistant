[Unit]
Description=Secure Web Assistant — Phishing Detection API (Gunicorn)
After=network.target

[Service]
Type=notify
User=phishing-api
Group=phishing-api
WorkingDirectory=/opt/secure_web_assistant/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/gunicorn -c gunicorn_conf.py app.main:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Low-latency browser extension queries: keep timeouts tight.
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target